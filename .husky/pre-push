zero=0000000000000000000000000000000000000000
planning_only=1
checked_any=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  checked_any=1
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || { planning_only=0; continue; }
  else
    base=$remote_sha
  fi
  changed=$(git diff --name-only "$base" "$local_sha" 2>/dev/null) || { planning_only=0; continue; }
  for f in $changed; do
    case "$f" in
      .planning|.planning/*) ;;
      *) planning_only=0 ;;
    esac
  done
done

if [ "$checked_any" = "0" ]; then
  echo "Nothing to push; skipping pre-push checks."
  exit 0
fi

if [ "$planning_only" = "1" ]; then
  echo "Only .planning changes in this push; skipping pre-push checks."
  exit 0
fi

echo "Running pre-push checks..."

pnpm lint || { echo "Lint failed"; exit 1; }
pnpm typecheck || { echo "Typecheck failed"; exit 1; }
pnpm test || { echo "Tests failed"; exit 1; }
pnpm build || { echo "Build failed"; exit 1; }

echo "All pre-push checks passed!"
